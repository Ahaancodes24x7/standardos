 "requirements": [
  {
   "text": "Horizontal centrifugal pumps for clear cold water shall comply with IS 1520:1980.",
   "category": "general",
   "attributes": []
  },
  {
   "text": "Duty point of each pump shall be 250 m³/h discharge at 45 M total dynamic head.",
   "category": "performance",
   "attributes": [
    {
     "parameter": "flow_rate",
     "value": 250
    },
    {
     "parameter": "pump_head",
     "value": 45000
    }
   ],
   "standard": "is-1520-1980"
  },
  {
   "text": "PUMP CASING SHALL BE CI AND IMPELLER OF LEADED TIN BRONZE.",
   "category": "material",
   "attributes": [],
   "standard": "is-1520-1980"
  },
  {
   "text": "Sound pressure level shall be limited to 85 db(A) at 1 M distance.",
   "category": "environmental",
   "attributes": [
    {
     "parameter": "noise_level",
     "value": 85
    }
   ]
  },
  {
   "text": "Rated discharge: 250 m³/h",
   "category": "performance",
   "attributes": [
    {
     "parameter": "flow_rate",
     "value": 250
    }
   ],
   "standard": "is-1520-1980"
  },
  {
   "text": "Total dynamic head: 45 M",
   "category": "performance",
   "attributes": [
    {
     "parameter": "pump_head",
     "value": 45000
    }
   ],
   "standard": "is-1520-1980"
  },
  {
   "text": "The drive motor shall be a three phase TEFC squirrel cage induction motor as per IS 325:1996.",
   "category": "general",
   "attributes": []
  },
  {
   "text": "Motor rating shall be 37 KW continuous.",
   "category": "performance",
   "attributes": [
    {
     "parameter": "rated_power",
     "value": 37000
    }
   ],
   "standard": "is-325-1996"
  },
  {
   "text": "Motors shall operate satisfactorily on a supply of 415 Volts ± 10 percent and 50Hz ± 5 percent.",
   "category": "electrical",
   "attributes": [
    {
     "parameter": "rated_voltage",
     "value": 415
    },
    {
     "parameter": "voltage_variation",
     "value": 10
    },
    {
     "parameter": "frequency",
     "value": 50
    },
    {
     "parameter": "frequency_variation",
     "value": 5
    }
   ],
   "standard": "is-325-1996"
  },
  {
   "text": "The motor shall be premium efficiency IE3 conforming to IS 12615:2018.",
   "category": "performance",
   "attributes": [
    {
     "parameter": "efficiency_class",
     "text": "IE3"
    }
   ]
  },
  {
   "text": "Insulation shall be class F and the motor shall be rated for S1 continuous duty.",
   "category": "electrical",
   "attributes": [
    {
     "parameter": "insulation_class",
     "text": "Class F"
    },
    {
     "parameter": "duty_type",
     "text": "S1"
    }
   ],
   "standard": "is-325-1996"
  },
  {
   "text": "Motor speed shall be 1500 rpm (4 pole).",
   "category": "performance",
   "attributes": [
    {
     "parameter": "speed",
     "value": 1500
    }
   ],
   "standard": "is-325-1996"
  },
  {
   "text": "The quality of water supplied shall meet IS 10500:2012.",
   "category": "quality",
   "attributes": []
  },
  {
   "text": "PH VALUE: 6.5 TO 8.5",
   "category": "quality",
   "attributes": [
    {
     "parameter": "ph",
     "value": 6.5
    }
   ],
   "standard": "is-10500-2012"
  },
  {
   "text": "TDS of supplied water shall be within 500 mg/l.",
