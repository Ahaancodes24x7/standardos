# Postgres connection string used by the app at runtime (Drizzle + postgres.js).
DATABASE_URL=

# Optional: separate connection string for running migrations (e.g. a direct,
# non-pooled connection). Falls back to DATABASE_URL when unset.
DB_MIGRATION_URL=

# Random string (32+ characters) used to encrypt/sign the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Shared secret(s) for authenticating scheduled/cron requests.
CRON_SECRET=
CRON_SECRET_PREVIOUS=
