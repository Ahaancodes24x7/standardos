   "category": "quality",
   "attributes": [
    {
     "parameter": "bacteriological_quality"
    }
   ],
   "standard": "is-10500-2012"
  },
  {
   "text": "Performance tests on each pump shall be conducted as per IS 9137 in the presence of the Engineer.",
   "category": "testing",
   "attributes": []
  },
  {
