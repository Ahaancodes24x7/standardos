   "attributes": [
    {
     "parameter": "tds",
     "value": 500
    }
   ],
   "standard": "is-10500-2012"
  },
  {
   "text": "Turbidity of treated water shall be limited to 1 N.T.U..",
   "category": "quality",
   "attributes": [
    {
     "parameter": "turbidity",
     "value": 1
    }
   ],
   "standard": "is-10500-2012"
  },
  {
   "text": "Fluoride content shall be within 1.0 mg/l.",
   "category": "quality",
   "attributes": [
    {
     "parameter": "fluoride",
     "value": 1.0
    }
   ],
   "standard": "is-10500-2012"
  },
  {
   "text": "Nitrate as NO3 shall be less than 45 mg/l.",
