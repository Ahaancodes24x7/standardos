# Read by the FastAPI backend (backend/app/config.py) from ./.env or ../.env.
# Real environment variables take precedence over this file.

# Postgres connection string (postgres:// or postgresql:// — the psycopg driver is added automatically).
DATABASE_URL=

# Optional: max connections per API process (keep small on serverless, e.g. 3).
DATABASE_POOL_MAX=

# Optional: separate connection string for Alembic migrations (e.g. a direct,
# non-pooled connection). Takes precedence over DATABASE_URL for `alembic upgrade`.
# Make sure it points at the database you intend to migrate.
DB_MIGRATION_URL=

# Random string (32+ characters) used to sign the session cookie.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Set true when the API is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Origins allowed to call the API directly with credentials (only needed when the
# frontend calls a separately hosted API via VITE_API_URL instead of the /api gateway).
CORS_ORIGINS=http://localhost:3000

# Shared secret(s) for GET /api/cron/analysis-sweeper (Authorization: Bearer <secret>).
CRON_SECRET=
CRON_SECRET_PREVIOUS=

# Optional LLM copy-editing of proposed specification repairs (off by default).
# When "on", repair wording is rephrased by Claude and each rewrite is rejected
# unless every number, standard designation and placeholder is unchanged.
# Sends repair text (derived from the uploaded specification) to the Anthropic API.
STANDARDOS_LLM_REPAIR=off
# Pipeline preset for analyses: v3.1 (default), v3.1-gated / v3.1-hybrid (learned classifier,
# needs `uv sync --extra ml` in aiml/ and `python -m evaluation.classifiers`), v3.1-dag, v3, legacy-2.1.
STANDARDOS_PIPELINE_CONFIG=v3.1
# Comma-separated e-mails allowed to import a standards corpus from the Admin page.
ADMIN_EMAILS=
# Credentials for the above; the SDK also accepts an `ant auth login` profile.
ANTHROPIC_API_KEY=

# --- Frontend (TanStack Start) ---
# Where the /api gateway route (src/routes/api/$.ts) and server-side rendering reach FastAPI.
API_INTERNAL_URL=http://127.0.0.1:8000
# Optional: call a separately hosted API directly from the browser instead of via the gateway.
VITE_API_URL=
